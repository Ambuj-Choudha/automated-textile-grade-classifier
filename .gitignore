# Python
__pycache__/
*.pyc
.pytest_cache/

# Virtual environments
env/
venv/
.venv/

# IDE / editor / OS
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db

# ITA-Net transient artifacts (generated by the DLL during training and recall)
*.dat
*.nrm
*.nri
*.nro
*.err
*.xcl
*.neu

# ITA-Net archive (timestamped .NET + .TRN snapshots; restored manually if needed)
models/itanet/archive/

# ITA-Net shared DLL (compiled binary, rebuilt from ITA-net-repo — see docs/INTEGRATION.md)
models/itanet/common/*.dll

# Runtime data (camera captures, training CSVs, ITA-Net inputs) — top-level only
/data/

# Per-grade itanet data dir: ignore everything except the two filelists the DLL reads
models/itanet/*/data/*
!models/itanet/*/data/recall.fls
!models/itanet/*/data/training.fls

# Generated outputs and reports
output/
reports/

# Test artifacts written by app/tests/test_integration.py
_test_predictions*.csv

# *.shf.* — shuffled/intermediate files (e.g. foo.shf.dat, bar.shf.txt)
*.shf.*
